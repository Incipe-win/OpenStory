# ─── Server ──────────────────────────────────────────
SERVER_PORT=8080
APP_ENV=development   # development | staging | production
APP_VERSION=0.1.0

# ─── Database (PostgreSQL) ───────────────────────────
DATABASE_URL=postgres://openstory:openstory@localhost:15432/openstory?sslmode=disable

# ─── Redis ───────────────────────────────────────────
REDIS_ADDR=localhost:16379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Kafka ───────────────────────────────────────────
KAFKA_BROKERS=localhost:19092

# ─── MinIO (S3-compatible) ───────────────────────────
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=openstory
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# ─── Product limits ─────────────────────────────────
RATE_LIMIT_USER_PER_MINUTE=120
RATE_LIMIT_IP_PER_MINUTE=300
TASK_CONCURRENT_LIMIT=5

# ─── Observability ──────────────────────────────────
OBSERVABILITY_ADDR=:9090
OTEL_SERVICE_NAME=openstory
OTEL_TRACES_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true

# ─── Providers ──────────────────────────────────────
PROVIDER_MAX_ATTEMPTS=2
# Required only when reading encrypted provider_configs from PostgreSQL.
PROVIDER_CONFIG_ENCRYPTION_KEY=

# OpenAI-compatible text generation. API key may also be stored encrypted in provider_configs.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_API_KEY=

# Adapter skeletons. API keys must come from env or encrypted provider_configs.
COMFYUI_BASE_URL=
COMFYUI_API_KEY=
REPLICATE_BASE_URL=https://api.replicate.com/v1
REPLICATE_API_TOKEN=

# ─── Proxy (for Docker build) ───────────────────────
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
