# ============================================================
# OpenStory Production Configuration Template
# ============================================================
# Setup:
#   cp .env.production .env
#   # Edit MINIO_PUBLIC_ENDPOINT to match your domain/IP
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Access: http://incipe.top
# ============================================================

# ─── Server ──────────────────────────────────────────
SERVER_PORT=8080
APP_ENV=production
APP_VERSION=0.1.0

# ─── Database (PostgreSQL) ───────────────────────────
DATABASE_URL=postgres://openstory:096ef151b8a7a96293ce002ee3025de5@postgres:5432/openstory?sslmode=disable

# ─── Redis ───────────────────────────────────────────
REDIS_ADDR=redis:6379
REDIS_PASSWORD=8a7dc25d81ade9c1693e23dd5ee9d600
REDIS_DB=0

# ─── Kafka ───────────────────────────────────────────
KAFKA_BROKERS=kafka:9092

# ─── MinIO (S3-compatible) ───────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=81dab039671c13b45b0a9997ebdda4a6
MINIO_BUCKET=openstory
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
# REQUIRED: Change to http://<YOUR_SERVER_IP>:9000 or https://<YOUR_DOMAIN>/minio
MINIO_PUBLIC_ENDPOINT=http://YOUR_SERVER_IP:9000

# ─── JWT ─────────────────────────────────────────────
JWT_SECRET=a3786f85e842fe523551ee19650ad43384b44258d56214519585296c1fd55ca6

# ─── Product limits ─────────────────────────────────
RATE_LIMIT_USER_PER_MINUTE=120
RATE_LIMIT_IP_PER_MINUTE=300
TASK_CONCURRENT_LIMIT=5

# ─── Observability ──────────────────────────────────
OBSERVABILITY_ADDR=:9090
OTEL_SERVICE_NAME=openstory
OTEL_TRACES_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true

# ─── Providers ──────────────────────────────────────
PROVIDER_MAX_ATTEMPTS=2
PROVIDER_CONFIG_ENCRYPTION_KEY=8e148784c51079b5855bced36da9754ffbd7b8260fa8520faaacb0fabf1e98c6

# OpenAI-compatible text generation
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_API_KEY=

# ComfyUI (optional)
COMFYUI_BASE_URL=
COMFYUI_API_KEY=

# Replicate (optional)
REPLICATE_BASE_URL=https://api.replicate.com/v1
REPLICATE_API_TOKEN=

# ─── HTTPS / Let's Encrypt (optional) ───────────────
# Uncomment and set these when you have a domain
# DOMAIN=openstory.example.com
# LETSENCRYPT_EMAIL=admin@example.com
